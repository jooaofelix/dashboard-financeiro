rules_version = '2';

/*
 * BASE é multi-inquilino: cada conta tem o próprio workspace em
 * `usuarios/{uid}`, com as coleções abaixo dele.
 *
 * O isolamento vive AQUI, não no cliente. A regra casa o `uid` do caminho com o
 * `uid` da sessão, então nem um app adulterado nem um acesso direto à API
 * conseguem ler ou escrever dados de outra conta. Não existe regra em nível de
 * raiz: qualquer caminho fora deste é negado por padrão.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function donoDaConta(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Perfil + configurações do workspace.
    match /usuarios/{uid} {
      allow read, write: if donoDaConta(uid);

      // Clientes, serviços, profissionais, atendimentos e transações — e
      // qualquer subcoleção futura do mesmo workspace.
      match /{documento=**} {
        allow read, write: if donoDaConta(uid);
      }
    }
  }
}
